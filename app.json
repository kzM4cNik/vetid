{
  "expo": {
    "name": "VetID",
    "slug": "vetid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vetid.clinic",
      "infoPlist": {
        "NSCameraUsageDescription": "VetID использует камеру, чтобы распознать пациента: кошку, собаку или человека.",
        "NSPhotoLibraryUsageDescription": "VetID открывает галерею, чтобы проверить пациента по фотографии.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vetid.clinic",
      "adaptiveIcon": {
        "backgroundColor": "#05070F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "VetID использует камеру, чтобы распознать пациента: кошку, собаку или человека.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VetID открывает галерею, чтобы проверить пациента по фотографии.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#05070F"
        }
      ],
      "expo-status-bar"
    ]
  }
}
